---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="placeholder">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="placeholder__copy">{description}</p>
  <a class="text-link" href={`${base}/`}>← Back to ajtech.au</a>
</section>
