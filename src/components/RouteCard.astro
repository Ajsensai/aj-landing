---
interface Props {
  href: string;
  number: string;
  title: string;
  description: string;
  status?: string;
}

const { href, number, title, description, status = "Explore" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolvedHref = `${base}${href}`;
---

<a class="route-card" href={resolvedHref}>
  <span class="route-number">{number}</span>
  <div class="route-card__content">
    <div class="route-card__title">
      <h3>{title}</h3>
      <span class="route-status">{status}</span>
    </div>
    <p>{description}</p>
  </div>
  <span class="route-arrow" aria-hidden="true">→</span>
</a>
