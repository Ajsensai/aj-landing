---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkCard from "../components/LinkCard.astro";
import PageHeading from "../components/PageHeading.astro";

import { projects } from "../data/projects";
---

<BaseLayout title="Projects — AJ Tech">
  <PageHeading
    title="Projects"
    description="A small collection of things I have built, tested or kept around."
  />

  <div class="link-grid">
    {projects.map((project) => <LinkCard {...project} />)}
  </div>
</BaseLayout>
