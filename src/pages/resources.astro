---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkCard from "../components/LinkCard.astro";
import PageHeading from "../components/PageHeading.astro";

const resources = [
  {
    title: "CodePen",
    description: "Front-end experiments and quick browser-based prototypes.",
    href: "https://codepen.io/",
    external: true,
  },
  {
    title: "YesHello",
    description: "A lightweight website and digital presence builder.",
    href: "https://yeshello.app/",
    external: true,
  },
  {
    title: "Material for MkDocs",
    description: "Documentation tooling and a reference for clean technical publishing.",
    href: "https://squidfunk.github.io/mkdocs-material/",
    external: true,
  },
];
---

<BaseLayout title="Resources — AJ Tech">
  <PageHeading
    title="Resources"
    description="Useful tools, references and sites I want to be able to find again."
  />

  <div class="link-grid">
    {resources.map((resource) => <LinkCard {...resource} />)}
  </div>
</BaseLayout>
