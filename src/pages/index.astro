---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkCard from "../components/LinkCard.astro";

const links = [
  {
    href: "/projects",
    title: "Projects",
    description: "Repositories, builds and experiments.",
  },
  {
    href: "/blog",
    title: "Blog",
    description: "Notes on security, infrastructure and whatever else I am learning.",
  },
  {
    href: "/papers",
    title: "Papers",
    description: "Longer-form technical and research work.",
  },
  {
    href: "/resources",
    title: "Resources",
    description: "Links, tools and references I want to keep around.",
  },
  {
    href: "/resume",
    title: "Resume",
    description: "Current work history and experience.",
  },
];
---

<BaseLayout>
  <section class="intro">
    <p class="intro__kicker">Sydney, Australia</p>
    <h1>Projects, notes and useful things.</h1>
    <p class="intro__copy">
      I work in cyber security and like building useful things, pulling apart
      how systems work, and automating the boring bits.
    </p>
    <p class="intro__copy">
      This site is mostly somewhere to keep things I find interesting.
    </p>
  </section>

  <section class="home-links" aria-labelledby="home-links-title">
    <div class="section-heading">
      <h2 id="home-links-title">On this site</h2>
    </div>

    <div class="link-grid">
      {links.map((link) => <LinkCard {...link} />)}
    </div>
  </section>
</BaseLayout>
